@using Application.Issues.ViewModels
@model IssueByStatusViewModel

@{
    ViewBag.Title = "Home Page";
}

@Scripts.Render("~/bundles/jquery")
<script src="~/Scripts/bootstrap.bundle.js"></script>
@Scripts.Render("~/bundles/datatables")
<script src="~/Scripts/dataTables.bootstrap5.js"></script>
<script src="~/Scripts/Custom/dataTables_setup.js"></script>
<script src="~/Scripts/Custom/SPA_navigation.js"></script>
@Scripts.Render("~/bundles/toastr")

<div class="cards mb-2">

    <div class="card new">
        <div class="card-body">
            <i class="bi bi-hdd-stack card-icon"></i>
            <div class="card-info">
                <h2>@Model.New</h2>
                <span>New Issues</span>
            </div>
        </div>
        <button id="new" class="card-footer" onclick="reloadTable('New')">
            <span>View details</span>
            <i class="bi bi-arrow-right-circle-fill"></i>
        </button>
    </div>

    <div class="card pending">
        <div class="card-body">
            <i class="bi bi-arrow-clockwise card-icon"></i>
            <div class="card-info">
                <h2>@Model.Pending</h2>
                <span>Pending</span>
            </div>
        </div>
        <button id="pending" class="card-footer" onclick="reloadTable('Pending')">
            <span>View details</span>
            <i class="bi bi-arrow-right-circle-fill"></i>
        </button>
    </div>

    <div class="card assigned">
        <div class="card-body">
            <i class="bi bi-arrow-90deg-right card-icon"></i>
            <div class="card-info">
                <h2>@Model.Assigned</h2>
                <span>Assigned</span>
            </div>
        </div>
        <button id="assigned" class="card-footer" onclick="reloadTable('Processing (assigned)')">
            <span>View details</span>
            <i class="bi bi-arrow-right-circle-fill"></i>
        </button>
    </div>

    <div class="card progresss">
        <div class="card-body">
            <i class="bi bi-arrow-repeat card-icon"></i>
            <div class="card-info">
                <h2>@Model.Solved</h2>
                <span>Solved</span>
            </div>
        </div>
        <button id="solved" class="card-footer" onclick="reloadTable('Solved')">
            <span>View details</span>
            <i class="bi bi-arrow-right-circle-fill"></i>
        </button>
    </div>

</div>
<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-secondary" id="ClearFilters" onclick="clearFilters()" disabled>Clear Filters</button>
</div>

<table id="IssuesTable"
       class="display stripe cell-border"
       style="width:100%" data-table="IssuesTable"></table>


<script>
    var stat = "";

    initDataTables();
    initTableInteractions("IssuesTable", "Issue", "Issue");

    

    function reloadTable(text) {
        stat = text;
        myTable.ajax.reload();
    }

    $('#new, #pending, #assigned, #solved').on('click', function () {
        $('#ClearFilters').prop('disabled', false);
    });

    function clearFilters() {
        stat = "";
        $('#ClearFilters').prop('disabled', true);
        myTable.ajax.reload();
    }
</script>