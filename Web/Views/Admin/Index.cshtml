
@{
    ViewBag.Title = "Index";
}

@Scripts.Render("~/bundles/jquery")
<script src="~/Scripts/bootstrap.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
@Scripts.Render("~/bundles/datatables")
<script src="~/Scripts/Custom/dataTables_setup.js"></script>
<script src="~/Scripts/Custom/SPA_navigation.js"></script>
@Scripts.Render("~/bundles/toastr")

<div class="text-lg-start fw-bold">
    <h2 class="display-4">Users manager</h2>
    <hr />
</div>

<div class="table-actions">
    <button id="addUser" class="btn btn-primary" onclick="openModal({url: '/Admin/GetAddUser', data: 0})">Add User</button>
    <button id="editUserBtn" disabled>Edit User</button>
    <button id="UserDetailsBtn" disabled>Details</button>
</div>

<div class="justify-content-center">
    <table id="usersTable"
           class="display stripe cell-border"
           style="width:100%" data-table="usersTable"></table>
</div>



<script>
    initDataTables();

    var tab = $('#usersTable').DataTable();

    $('#usersTable tbody').off('click').on('click', 'tr', function () {

        if ($(this).hasClass('selected')) {
            $(this).removeClass('selected');
            selectedUser = null;
        } else {
            tab.$('tr.selected').removeClass('selected');
            $(this).addClass('selected');
            selectedUser = tab.row(this).data();
        }
        $(`#editUserBtn`).prop('disabled', !selectedUser);
        $(`#UserDetailsBtn`).prop('disabled', !selectedUser);

    });

    $(`#editUserBtn`).off('click').on('click', function () {
        openModal({ url: '/Admin/GetEditUser', data: selectedUser.Id });
    });

    $(`#UserDetailsBtn`).off('click').on('click', function () {
        openModal({ url: '/Admin/GetUserDetails', data: selectedUser.Id });
    });
</script>